/* Window chrome and the colour tokens both pickers draw from. GradientTabs.uss builds the shell on
   top of these, and GradientCube.uss the 3D viewport. */

/* A colour tool should not out-saturate the thing being coloured, which the old lime-and-cyan
   chrome plainly did: its buttons were louder than most gradients authored in front of them. Near
   neutral charcoal with a faint cool bias, one accent, and semantic red kept separate from it.
   The accent is the yellow already used for a selected key handle, so it is continuous with what
   the package had rather than invented. */
:root {
    --bg: #16181c;
    --panel: #1d2025;
    --raise: #262a31;
    --raise-hi: #2f343c;
    --border: #333941;
    --text: #e8eaee;
    --muted: #9aa2af;
    --dim: #6e7683;
    --accent: #f0b429;
    --accent-ink: #1b1405;
    --danger: #e5534b;
}

.abcw-picker {
    background-color: var(--bg);
    color: var(--text);
}

.abcw-picker Label {
    color: var(--text);
}

.abcw-picker-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 6px;
    cursor: arrow;
}

.abcw-card {
    background-color: var(--panel);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 8px;
}

.abcw-btn {
    color: var(--text);
    background-color: var(--raise);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 3px;
}

.abcw-btn:hover {
    background-color: var(--raise-hi);
}

.abcw-btn--accent {
    color: var(--accent-ink);
    background-color: var(--accent);
    border-color: var(--accent);
    -unity-font-style: bold;
}

.abcw-btn--accent:hover {
    background-color: #ffc53d;
    border-color: #ffc53d;
}

.abcw-ok-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 6px;
}

.abcw-flex-spacer {
    flex-grow: 1;
}

.abcw-library__tile {
    flex-basis: 31%;
    min-width: 150px;
    max-width: 320px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 6px;
    background-color: var(--panel);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 4px;
}

/* Scrollbars in the accent, USS only. */
.abcw-picker .unity-scroller {
    background-color: var(--raise);
}

.abcw-picker .unity-scroller .unity-dragger,
.abcw-picker .unity-base-slider__dragger {
    background-color: var(--accent);
}

.abcw-picker .unity-slider__tracker,
.abcw-picker .unity-base-slider__tracker {
    background-color: var(--raise);
}
