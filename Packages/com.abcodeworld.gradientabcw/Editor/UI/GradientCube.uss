/* The 3D picker's cube viewport, its key dots, and the mode column that replaces the 1D picker's
   draggable palette swatches. Pairs with GradientPickerWindow.uss, which supplies the window chrome. */

/* Fixed rather than flex-grow: the cube is drawn into a centred square sized by the shorter side of
   this host, so every pixel of width past its height was dead space. Narrowing it is what makes room
   for the actions column beside it. */
.abcw-cube-host {
    width: 320px;
    flex-shrink: 0;
}

/* A floor rather than a fixed height: it grows to fill the host, which the row has already stretched to
   match the actions column beside it, so a taller panel makes a taller cube instead of leaving a gap
   under one of them. The floor is the height the cube had before that column moved up here, because a
   panel shorter than the cube must not shrink it. */
.abcw-cube {
    flex-grow: 1;
    min-height: 280px;
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border);
    border-radius: 3px;
    overflow: hidden;
}

/* Sits over the viewport rather than in its flow, so the cube keeps the whole area. */
.abcw-cube__toggle {
    position: absolute;
    top: 4px;
    right: 4px;
    height: 18px;
    padding-left: 8px;
    padding-right: 8px;
    margin: 0;
}

/* Colour keys are circles filled with their own colour. */
.abcw-cube-key {
    border-width: 1px;
    border-color: rgb(12, 16, 24);
    border-radius: 50%;
}

/* Alpha keys are diamonds filled with their value as a grey, so the two kinds differ in shape as well
   as in fill — a mid-grey colour key and a half-alpha key would otherwise be indistinguishable. */
.abcw-cube-key--alpha {
    border-radius: 1px;
    border-color: rgb(235, 240, 250);
    rotate: 45deg;
}

/* Whichever kind is not being edited steps back, so the mode buttons have a visible effect. */
.abcw-cube-key--muted {
    opacity: 0.3;
}

/* Declared after the two above so it wins the tie on equal specificity. Same yellow the 1D bar's
   selected handle uses, so a selection reads the same in both pickers. */
.abcw-cube-key--selected {
    border-color: rgb(255, 221, 0);
    border-width: 2px;
}

/* Same width and position as the 1D picker's palette column, holding buttons instead of drag sources. */
.abcw-mode-column {
    width: 100px;
    min-width: 100px;
    max-width: 100px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 6px;
    padding: 4px;
    margin-right: 6px;
    flex-direction: column;
    justify-content: flex-start;
}

/* Takes whatever width the cube column gave up. The minimum is where the Falloff row still has a
   usable slider track after its 90px label, 60px field and 18px reset button. */
.abcw-actions-column {
    flex-grow: 1;
    min-width: 300px;
    margin-left: 6px;
}

.abcw-mode-selector {
    flex-direction: column;
}

.abcw-mode-btn {
    height: 34px;
    margin: 2px 0;
    color: var(--text);
    background-color: #1b2c47;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
}

.abcw-mode-btn:hover {
    background-color: #24395b;
}

.abcw-mode-btn--active {
    color: var(--blue);
    background-color: var(--accent);
    border-color: var(--accent);
}

.abcw-mode-btn--active:hover {
    background-color: #c8ff66;
}
