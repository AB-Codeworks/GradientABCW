/* Cube-specific rules for the 3D inspector field and picker. Pairs with GradientABCWField.uss, which
   already supplies .abcw-gradient-preview and its clickable variant; only what a cube adds is here. */

.abcw-cube-strip {
    flex-direction: row;
    flex-shrink: 0;
}

/* The last render keeps its right margin. USS has no structural selectors — :last-child,
   :first-child and :nth-child are all CSS-only, and UI Toolkit warns and discards the rule — and the
   three pixels are invisible: a flex-grow spacer follows the strip in the field header, and a
   vertical button row follows it in a library tile. */
.abcw-cube-preview {
    margin-right: 3px;
}

.abcw-falloff-row--disabled {
    opacity: 0.5;
}
