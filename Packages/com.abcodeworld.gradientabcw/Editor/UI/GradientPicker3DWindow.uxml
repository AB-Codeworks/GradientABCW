<ui:UXML xmlns:ui="UnityEngine.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ui:VisualElement name="root" class="abcw-picker-root">

    <ui:VisualElement name="libraryHost" class="abcw-card abcw-library-host" />

    <ui:VisualElement name="editorHost" class="abcw-card abcw-editor-host">
      <ui:VisualElement name="cubeRow" class="abcw-bar-row">
        <ui:VisualElement name="modeHost" class="abcw-mode-column" />
        <ui:VisualElement name="cubeHost" class="abcw-cube-host" />
      </ui:VisualElement>

      <ui:VisualElement name="listsRow" class="abcw-lists-row">
        <ui:VisualElement name="colorListHost" class="abcw-card abcw-list-col" />
        <ui:VisualElement name="alphaListHost" class="abcw-card abcw-list-col" />
        <ui:VisualElement name="actionsHost" class="abcw-card abcw-list-col" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="okRow" class="abcw-ok-row">
      <ui:VisualElement class="abcw-flex-spacer" />
      <ui:Button name="okBtn" text="OK" class="abcw-btn abcw-btn--accent" />
      <ui:Button name="cancelBtn" text="Cancel" class="abcw-btn" />
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
